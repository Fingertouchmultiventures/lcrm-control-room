      "chapter": {
        "number": 2,
        "content": [
          {
            "type": "heading",
            "content": [
              "Ìṣubú Ninefe"
            ]
          },
          {
            "type": "verse",
            "number": 1,
            "content": [
              {
                "text": "Àwọn apanirun ti dìde sí ọ, ìwọ Ninefe.",
                "poem": 1
              },
              {
                "text": "Pa ilé ìṣọ́ mọ́,",
                "poem": 2
              },
              {
                "lineBreak": true
              },
              {
                "text": "ṣọ́ ọ̀nà náà,",
                "poem": 2
              },
              {
                "lineBreak": true
              },
              {
                "text": "di àmùrè,",
                "poem": 2
              },
              {
                "lineBreak": true
              },
              {
                "text": "ẹ̀gbẹ́ rẹ kí ó le múra gírí.",
                "poem": 2
              }
            ]
          },
          {
            "type": "line_break"
          },
          {
            "type": "verse",
            "number": 2,
            "content": [
              {
                "text": "Olúwa yóò mú ọláńlá Jakọbu padà sípò",
                "poem": 1
              },
              {
                "text": "gẹ́gẹ́ bí ọláńlá Israẹli",
                "poem": 2
              },
              {
                "text": "bí ó tilẹ̀ jẹ́ pé àwọn apanirun ti pa ibẹ̀ run,",
                "poem": 1
              },
              {
                "text": "tí wọ́n sì ba ẹ̀ka àjàrà wọn jẹ́.",
                "poem": 2
              }
            ]
          },
          {
            "type": "line_break"
          },
          {
            "type": "verse",
            "number": 3,
            "content": [
              {
                "text": "Asà àwọn ọmọ-ogun rẹ̀ sì di pupa;",
                "poem": 1
              },
              {
                "text": "àwọn ológun wọn sì wọ aṣọ òdòdó.",
                "poem": 2
              },
              {
                "text": "Idẹ tí ó wà lórí kẹ̀kẹ́ ogun ń kọ mọ̀nàmọ́ná",
                "poem": 1
              },
              {
                "text": "ní ọjọ́ tí a bá pèsè wọn sílẹ̀ tán;",
                "poem": 2
              },
              {
                "lineBreak": true
              },
              {
                "text": "igi firi ni a ó sì mì tìtì.",
                "poem": 2
              }
            ]
          },
          {
            "type": "verse",
            "number": 4,
            "content": [
              {
                "text": "Àwọn kẹ̀kẹ́ ogun yóò ya bo àwọn pópónà,",
                "poem": 1
              },
              {
                "text": "wọn yóò sì máa sáré síwá àti sẹ́yìn ní àárín ìgboro.",
                "poem": 2
              },
              {
                "text": "Wọn sì dàbí ètùfù iná;",
                "poem": 1
              },
              {
                "text": "tí ó sì kọ bí i mọ̀nàmọ́ná.",
                "poem": 2
              }
            ]
          },
          {
            "type": "line_break"
          },
          {
            "type": "verse",
            "number": 5,
            "content": [
              {
                "text": "Ninefe yóò ṣe àṣàrò àwọn ọlọ́lá rẹ̀;",
                "poem": 1
              },
              {
                "text": "síbẹ̀ wọ́n ń kọsẹ̀ ní ojú ọ̀nà wọn;",
                "poem": 2
              },
              {
                "text": "wọn sáré lọ sí ibi odi rẹ̀,",
                "poem": 1
              },
              {
                "text": "a ó sì pèsè ààbò rẹ̀.",
                "poem": 2
              }
            ]
          },
          {
            "type": "verse",
            "number": 6,
            "content": [
              {
                "text": "A ó ṣí ìlẹ̀kùn àwọn odò wọ̀n-ọn-nì sílẹ̀,",
                "poem": 1
              },
              {
                "text": "a ó sì mú ààfin náà di wíwó palẹ̀.",
                "poem": 2
              }
            ]
          },
          {
            "type": "verse",
            "number": 7,
            "content": [
              {
                "text": "A pa á láṣẹ pé ìlú náà, èyí tí a ti fi ìdí rẹ̀ múlẹ̀",
                "poem": 1
              },
              {
                "text": "ni a ó sì kó ní ìgbèkùn lọ.",
                "poem": 2
              },
              {
                "text": "A ó sì mú un gòkè wá",
                "poem": 1
              },
              {
                "text": "àti àwọn ìránṣẹ́bìnrin rẹ̀ yóò kérora bí ti ẹyẹ àdàbà,",
                "poem": 2
              },
              {
                "lineBreak": true
              },
              {
                "text": "wọn a sì máa lu àyà wọn.",
                "poem": 2
              }
            ]
          },
          {
            "type": "verse",
            "number": 8,
            "content": [
              {
                "text": "Ninefe dàbí adágún omi,",
                "poem": 1
              },
              {
                "text": "tí omi rẹ̀ sì ń gbẹ́ ẹ lọ.",
                "poem": 2
              },
              {
                "text": "“Dúró! Dúró!” ni wọ́n ó máa kígbe,",
                "poem": 1
              },
              {
                "text": "ṣùgbọ́n ẹnìkankan kì yóò wo ẹ̀yìn.",
                "poem": 2
              }
            ]
          },
          {
            "type": "verse",
            "number": 9,
            "content": [
              {
                "text": "“Ẹ kó ìkógun fàdákà!",
                "poem": 1
              },
              {
                "text": "Ẹ kó ìkógun wúrà!",
                "poem": 2
              },
              {
                "text": "Ìṣúra wọn ti kò lópin náà,",
                "poem": 1
              },
              {
                "text": "àti ọrọ̀ kúrò nínú gbogbo ohun èlò ti a fẹ́!”",
                "poem": 2
              }
            ]
          },
          {
            "type": "verse",
            "number": 10,
            "content": [
              {
                "text": "Òun ti ṣòfò, ó si di asán, ó sì di ahoro:",
                "poem": 1
              },
              {
                "text": "ọkàn pami, eékún ń lu ara wọn,",
                "poem": 2
              },
              {
                "lineBreak": true
              },
              {
                "text": "ìrora púpọ̀ sì wà nínú gbogbo ẹgbẹ́",
                "poem": 2
              },
              {
                "lineBreak": true
              },
              {
                "text": "àti ojú gbogbo wọ́n sì rẹ̀wẹ̀sì.",
                "poem": 2
              }
            ]
          },
          {
            "type": "line_break"
          },
          {
            "type": "verse",
            "number": 11,
            "content": [
              {
                "text": "Níbo ni ihò àwọn kìnnìún wà",
                "poem": 1
              },
              {
                "text": "àti ibi ìjẹun àwọn ọmọ kìnnìún,",
                "poem": 2
              },
              {
                "text": "níbi tí kìnnìún, àní abo kìnnìún tí ń rìn,",
                "poem": 1
              },
              {
                "text": "àti ọmọ kìnnìún, láìsí ohun ìbẹ̀rù.",
                "poem": 2
              }
            ]
          },
          {
            "type": "verse",
            "number": 12,
            "content": [
              {
                "text": "Kìnnìún tipa ọ̀pọ̀lọpọ̀ fún àwọn ọmọ rẹ̀,",
                "poem": 1
              },
              {
                "text": "ó sì fún un ẹran ọdẹ ní ọrùn pa fún àwọn abo kìnnìún rẹ̀,",
                "poem": 2
              },
              {
                "text": "ó sì fi ohun pípa kún ibùgbé rẹ̀",
                "poem": 1
              },
              {
                "text": "àti ihò rẹ̀ fún ohun ọdẹ.",
                "poem": 2
              }
            ]
          },
          {
            "type": "line_break"
          },
          {
            "type": "verse",
            "number": 13,
            "content": [
              {
                "text": "“Kíyèsi i èmi dojúkọ ọ́,”",
                "poem": 1
              },
              {
                "text": "ni Olúwa àwọn ọmọ-ogun wí.",
                "poem": 2
              },
              {
                "text": "“Èmi yóò sì fi kẹ̀kẹ́ rẹ̀ wọ̀n-ọn-nì jóná nínú èéfín,",
                "poem": 1
              },
              {
                "text": "idà yóò sì jẹ ọmọ kìnnìún rẹ̀ wọ̀n-ọn-nì run.",
                "poem": 2
              },
              {
                "lineBreak": true
              },
              {
                "text": "Èmi yóò sì ké ohun ọdẹ rẹ kúrò lórí ilẹ̀ ayé.",
                "poem": 2
              },
              {
                "text": "Ohùn àwọn ìránṣẹ́ rẹ",
                "poem": 1
              },
              {
                "text": "ni a kì yóò sì tún gbọ́ mọ́.”",
                "poem": 2
              }
            ]
          }
        ],
        "footnotes": []
      },
