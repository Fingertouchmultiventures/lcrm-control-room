      },
      "book": {
        "id": "NAM",
        "translationId": "yor_bib",
        "name": "Nahumu",
        "commonName": "Nahumu",
        "title": "Ìwé Wòlíì Nahumu",
        "order": 34,
        "numberOfChapters": 3,
        "sha256": "03212ed3d6665d346bd1736667ff14259bfc4bf00f269d23d7c63931aecf423f",
        "firstChapterNumber": 1,
        "firstChapterApiLink": "/api/yor_bib/NAM/1.json",
        "lastChapterNumber": 3,
        "lastChapterApiLink": "/api/yor_bib/NAM/3.json",
        "totalNumberOfVerses": 47
      },
      "chapter": {
        "number": 3,
        "content": [
          {
            "type": "heading",
            "content": [
              "A fi Ninefe bú"
            ]
          },
          {
            "type": "verse",
            "number": 1,
            "content": [
              {
                "text": "Ègbé ni fún ìlú ẹ̀jẹ̀ nì,",
                "poem": 1
              },
              {
                "text": "gbogbo rẹ̀ kún fún èké,",
                "poem": 2
              },
              {
                "text": "ó kún fún olè,",
                "poem": 1
              },
              {
                "text": "ìjẹ kò kúrò!",
                "poem": 2
              }
            ]
          },
          {
            "type": "verse",
            "number": 2,
            "content": [
              {
                "text": "Ariwo pàṣán àti ariwo",
                "poem": 1
              },
              {
                "text": "kíkùn kẹ̀kẹ́ ogun",
                "poem": 2
              },
              {
                "text": "àti jíjó ẹṣin",
                "poem": 1
              },
              {
                "text": "àti gbígbọn kẹ̀kẹ́ ogun jìgìjìgì!",
                "poem": 2
              }
            ]
          },
          {
            "type": "verse",
            "number": 3,
            "content": [
              {
                "text": "Ológun orí ẹṣin ń fi ìgbónára",
                "poem": 1
              },
              {
                "text": "ju idà wọn mọ̀nàmọ́ná",
                "poem": 2
              },
              {
                "lineBreak": true
              },
              {
                "text": "ọ̀kọ̀ rẹ̀ ti ń dán yanran sí òkè!",
                "poem": 2
              },
              {
                "text": "Ọ̀pọ̀lọpọ̀ si ní àwọn ẹni tí a pa,",
                "poem": 1
              },
              {
                "text": "àti ọ̀pọ̀lọpọ̀ òkú;",
                "poem": 2
              },
              {
                "text": "òkú kò sì ni òpin;",
                "poem": 1
              },
              {
                "text": "àwọn ènìyàn sì ń kọsẹ̀ lára àwọn òkú.",
                "poem": 2
              }
            ]
          },
          {
            "type": "verse",
            "number": 4,
            "content": [
              {
                "text": "Nítorí ọ̀pọ̀lọpọ̀ panṣágà",
                "poem": 1
              },
              {
                "text": "àgbèrè tí ó rójú rere gbà,",
                "poem": 2
              },
              {
                "text": "ìyá àjẹ́ tí ó ṣọ́ àwọn Orílẹ̀-èdè di ẹrú",
                "poem": 1
              },
              {
                "text": "nípa àgbèrè rẹ̀",
                "poem": 2
              },
              {
                "lineBreak": true
              },
              {
                "text": "àti àwọn ìdílé nípa ìṣe àjẹ́ rẹ̀.",
                "poem": 2
              }
            ]
          },
          {
            "type": "line_break"
          },
          {
            "type": "verse",
            "number": 5,
            "content": [
              {
                "text": "“Èmi dojúkọ ọ́,” ni Olúwa àwọn ọmọ-ogun wí.",
                "poem": 1
              },
              {
                "text": "“Èmi ó si ká aṣọ àwọ̀tẹ́lẹ̀ rẹ ní ojú rẹ.",
                "poem": 2
              },
              {
                "text": "Èmi yóò sì fi ìhòhò rẹ̀ han àwọn orílẹ̀-èdè",
                "poem": 1
              },
              {
                "text": "àti ìtìjú rẹ̀ han àwọn ilẹ̀ ọba.",
                "poem": 2
              }
            ]
          },
          {
            "type": "verse",
            "number": 6,
            "content": [
              {
                "text": "Èmi yóò da ẹ̀gbin tí ó ni ìríra sí ọ ní ara,",
                "poem": 1
              },
              {
                "text": "èmi yóò sì sọ ọ́ di aláìmọ́,",
                "poem": 2
              },
              {
                "lineBreak": true
              },
              {
                "text": "èmi yóò sì sọ ọ́ di ẹlẹ́yà.",
                "poem": 2
              }
            ]
          },
          {
            "type": "verse",
            "number": 7,
            "content": [
              {
                "text": "Gbogbo àwọn tí ó ba sì wò ọ́ yóò sì káàánú fún ọ, wọn yóò sì wí pé,",
                "poem": 1
              },
              {
                "text": "‘Ninefe ṣòfò, ta ni yóò kẹ́dùn rẹ?’",
                "poem": 2
              },
              {
                "lineBreak": true
              },
              {
                "text": "Níbo ni èmi o ti wá olùtùnú fún ọ?”",
                "poem": 2
              }
            ]
          },
          {
            "type": "line_break"
          },
          {
            "type": "verse",
            "number": 8,
            "content": [
              {
                "text": "Ǹjẹ́ ìwọ ha sàn ju Tebesi lọ,",
                "poem": 1
              },
              {
                "text": "èyí tí ó wà ní ibi odò Naili,",
                "poem": 2
              },
              {
                "lineBreak": true
              },
              {
                "text": "tí omi sì yí káàkiri?",
                "poem": 2
              },
              {
                "text": "Odò náà sì jẹ́ ààbò rẹ̀,",
                "poem": 1
              },
              {
                "text": "omi si jẹ́ odi rẹ̀.",
                "poem": 2
              }
            ]
          },
          {
            "type": "verse",
            "number": 9,
            "content": [
              {
                "text": "Etiopia àti Ejibiti ni agbára rẹ, kò sí ní òpin;",
                "poem": 1
              },
              {
                "text": "Puti àti Libia ni àwọn olùgbèjà rẹ̀.",
                "poem": 2
              }
            ]
          },
          {
            "type": "verse",
            "number": 10,
            "content": [
              {
                "text": "Síbẹ̀síbẹ̀ a kó o ní ìgbèkùn",
                "poem": 1
              },
              {
                "text": "o sì lọ sí oko ẹrú.",
                "poem": 2
              },
              {
                "text": "Àwọn ọmọ wẹ́wẹ́ rẹ̀ ni a ó fọ́ mọ́lẹ̀",
                "poem": 1
              },
              {
                "text": "ní orí ìta gbogbo ìgboro.",
                "poem": 2
              },
              {
                "text": "Wọ́n sì di ìbò nítorí àwọn ọlọ́lá rẹ̀ ọkùnrin,",
                "poem": 1
              },
              {
                "text": "gbogbo àwọn ọlọ́lá rẹ ni a sì fi ẹ̀wọ̀n dè.",
                "poem": 2
              }
            ]
          },
          {
            "type": "verse",
            "number": 11,
            "content": [
              {
                "text": "Ìwọ pẹ̀lú yóò sì mu àmupara;",
                "poem": 1
              },
              {
                "text": "a ó sì fi ọ́ pamọ́",
                "poem": 2
              },
              {
                "lineBreak": true
              },
              {
                "text": "ìwọ pẹ̀lú yóò máa ṣe àfẹ́rí ààbò nítorí ti ọ̀tá náà.",
                "poem": 2
              }
            ]
          },
          {
            "type": "line_break"
          },
          {
            "type": "verse",
            "number": 12,
            "content": [
              {
                "text": "Gbogbo ilé ìṣọ́ agbára rẹ yóò dàbí igi ọ̀pọ̀tọ́",
                "poem": 1
              },
              {
                "text": "pẹ̀lú àkọ́pọ́n èso wọn;",
                "poem": 2
              },
              {
                "text": "nígbà tí wọ́n bá ń gbọ̀n wọ́n,",
                "poem": 1
              },
              {
                "text": "ọ̀pọ̀tọ́ yóò sì bọ́ sí ẹnu àwọn ọ̀jẹun.",
                "poem": 2
              }
            ]
          },
          {
            "type": "verse",
            "number": 13,
            "content": [
              {
                "text": "Kíyèsi gbogbo àwọn jagunjagun!",
                "poem": 1
              },
              {
                "text": "Obìnrin ni gbogbo wọn.",
                "poem": 2
              },
              {
                "text": "Ojú ibodè rẹ ní a ó ṣí sílẹ̀ gbagada,",
                "poem": 1
              },
              {
                "text": "fún àwọn ọ̀tá rẹ;",
                "poem": 2
              },
              {
                "lineBreak": true
              },
              {
                "text": "iná yóò jó ọ̀pá ìdábùú ìlẹ̀kùn ibodè rẹ.",
                "poem": 2
              }
            ]
          },
          {
            "type": "line_break"
          },
          {
            "type": "verse",
            "number": 14,
            "content": [
              {
                "text": "Pọn omi nítorí ìhámọ́,",
                "poem": 1
              },
              {
                "text": "mú ilé ìṣọ́ rẹ lágbára sí i",
                "poem": 2
              },
              {
                "text": "wọ inú amọ̀",
                "poem": 1
              },
              {
                "text": "kí o sì tẹ erùpẹ̀,",
                "poem": 2
              },
              {
                "lineBreak": true
              },
              {
                "text": "kí ó sì tún ibi tí a ti ń sun bíríkì-amọ̀ ṣe kí ó le.",
                "poem": 2
              }
            ]
          },
          {
            "type": "verse",
            "number": 15,
            "content": [
              {
                "text": "Níbẹ̀ ni iná yóò ti jó ọ́ run;",
                "poem": 1
              },
              {
                "text": "idà yóò sì ké ọ kúrò,",
                "poem": 2
              },
              {
                "lineBreak": true
              },
              {
                "text": "yóò sì jẹ ọ́ bí i kòkòrò,",
                "poem": 2
              },
              {
                "text": "yóò sì sọ ara rẹ̀ di púpọ̀ bí i tata,",
                "poem": 1
              },
              {
                "text": "àní, di púpọ̀ bí eṣú!",
                "poem": 2
              }
            ]
          },
          {
            "type": "verse",
            "number": 16,
            "content": [
              {
                "text": "Ìwọ ti sọ àwọn oníṣòwò rẹ di púpọ̀",
                "poem": 1
              },
              {
                "text": "títí wọn yóò fi pọ̀ ju ìràwọ̀ ojú ọ̀run lọ,",
                "poem": 2
              },
              {
                "text": "ṣùgbọ́n bi eṣú ni wọn yóò sọ ilẹ̀ náà di ahoro, wọn yóò sì fò lọ.",
                "poem": 1
              }
            ]
          },
          {
            "type": "verse",
            "number": 17,
            "content": [
              {
                "lineBreak": true
              },
              {
                "text": "Àwọn aládé rẹ̀ dàbí eṣú,",
                "poem": 1
              },
              {
                "text": "àwọn ọ̀gágun rẹ dàbí ẹlẹ́ǹgà ńlá,",
                "poem": 2
              },
              {
                "lineBreak": true
              },
              {
                "text": "èyí tí ń dó sínú ọgbà ni ọjọ́ òtútù,",
                "poem": 2
              },
              {
                "text": "ṣùgbọ́n nígbà tí oòrùn jáde, wọ́n sálọ,",
                "poem": 1
              },
              {
                "text": "ẹnìkan kò sì mọ ibi tí wọ́n gbé wà.",
                "poem": 2
              }
            ]
          },
          {
            "type": "line_break"
          },
          {
            "type": "verse",
            "number": 18,
            "content": [
              {
                "text": "Ìwọ ọba Asiria,",
                "poem": 1
              },
              {
                "text": "àwọn olùṣọ́-àgùntàn rẹ̀ ń tòògbé;",
                "poem": 2
              },
              {
                "text": "àwọn ọlọ́lá rẹ dùbúlẹ̀ láti sinmi.",
                "poem": 1
              },
              {
                "text": "Àwọn ènìyàn rẹ fọ́nká lórí àwọn òkè ńlá,",
                "poem": 2
              },
              {
                "lineBreak": true
              },
              {
                "text": "tí ẹnikẹ́ni kò sì kó wọn jọ.",
                "poem": 2
              }
            ]
          },
          {
            "type": "verse",
            "number": 19,
            "content": [
              {
                "text": "Kò sì sí ohun tí ó lè wo ọgbẹ́ ẹ̀ rẹ sàn;",
                "poem": 1
              },
              {
                "text": "ọgbẹ́ rẹ kún fún ìrora,",
                "poem": 2
              },
              {
                "text": "Gbogbo ẹni tí ó bá sì gbọ́ ìròyìn rẹ",
                "poem": 1
              },
              {
                "text": "yóò pàtẹ́wọ́ lé ọ lórí,",
                "poem": 2
              },
              {
                "text": "nítorí ta ni kò ní pín nínú",
                "poem": 1
              },
              {
                "text": "ìwà búburú rẹ ti kò ti lópin.",
                "poem": 2
              }
            ]
          }
        ],
        "footnotes": []
      },
