      "chapter": {
        "number": 1,
        "content": [
          {
            "type": "verse",
            "number": 1,
            "content": [
              "Ọ̀rọ̀-ìmọ̀ nípa Ninefe. Ìwé ìran Nahumu ará Elkoṣi."
            ]
          },
          {
            "type": "line_break"
          },
          {
            "type": "heading",
            "content": [
              "Ìbínú Olúwa sí Ninefe"
            ]
          },
          {
            "type": "verse",
            "number": 2,
            "content": [
              {
                "text": "Ọlọ́run ń jẹ owú, ó sì ń gbẹ̀san,",
                "poem": 1
              },
              {
                "text": "Olúwa ń gbẹ̀san, ó sì kún fún ìbínú.",
                "poem": 2
              },
              {
                "text": "Olúwa ń gbẹ̀san lára àwọn ọ̀tá rẹ̀.",
                "poem": 1
              },
              {
                "text": "Ìbínú rẹ̀ kò sì yí padà lórí àwọn ọ̀tá rẹ̀.",
                "poem": 2
              }
            ]
          },
          {
            "type": "verse",
            "number": 3,
            "content": [
              {
                "text": "Olúwa lọ́ra láti bínú, ó sì tóbi ní agbára;",
                "poem": 1
              },
              {
                "text": "Olúwa kì yóò fi àwọn ẹlẹ́ṣẹ̀ sílẹ̀ láìjìyà.",
                "poem": 2
              },
              {
                "text": "Ọ̀nà rẹ̀ wà nínú afẹ́fẹ́ àti nínú ìjì,",
                "poem": 1
              },
              {
                "text": "ìkùùkuu sánmọ̀ sì ni eruku ẹsẹ̀ rẹ̀.",
                "poem": 2
              }
            ]
          },
          {
            "type": "verse",
            "number": 4,
            "content": [
              {
                "text": "Ó bá òkun wí, ó sì mú kí ó gbẹ;",
                "poem": 1
              },
              {
                "text": "Ó sìsọ gbogbo odò di gbígbẹ.",
                "poem": 2
              },
              {
                "text": "Baṣani àti Karmeli sì rọ.",
                "poem": 1
              },
              {
                "text": "Ìtànná Lebanoni sì rẹ̀ sílẹ̀.",
                "poem": 2
              }
            ]
          },
          {
            "type": "verse",
            "number": 5,
            "content": [
              {
                "text": "Àwọn òkè ńlá wárìrì níwájú rẹ̀,",
                "poem": 1
              },
              {
                "text": "àwọn òkè kéékèèké sì di yíyọ́,",
                "poem": 2
              },
              {
                "text": "ilẹ̀ ayé sì jóná níwájú rẹ̀,",
                "poem": 1
              },
              {
                "text": "àní ayé àti gbogbo àwọn tí ń gbé inú rẹ̀.",
                "poem": 2
              }
            ]
          },
          {
            "type": "verse",
            "number": 6,
            "content": [
              {
                "text": "Ta ni ó lé dúró níwájú ìbínú rẹ̀?",
                "poem": 1
              },
              {
                "text": "Ta ni ó lé faradà gbígbóná ìbínú rẹ̀?",
                "poem": 2
              },
              {
                "text": "Ìbínú rẹ̀ tú jáde bí iná;",
                "poem": 1
              },
              {
                "text": "àwọn àpáta sì fọ́ túútúú níwájú rẹ̀.",
                "poem": 2
              }
            ]
          },
          {
            "type": "line_break"
          },
          {
            "type": "verse",
            "number": 7,
            "content": [
              {
                "text": "Rere ni Olúwa,",
                "poem": 1
              },
              {
                "text": "òun ni ààbò ní ọjọ́ ìpọ́njú.",
                "poem": 2
              },
              {
                "text": "Òun sì tọ́jú àwọn tí ó gbẹ́kẹ̀lé e,",
                "poem": 1
              }
            ]
          },
          {
            "type": "verse",
            "number": 8,
            "content": [
              {
                "text": "ṣùgbọ́n pẹ̀lú ìkún omi ńlá",
                "poem": 2
              },
              {
                "text": "ní òun yóò fi ṣe ìparun láti ibẹ̀ dé òpin;",
                "poem": 1
              },
              {
                "text": "òkùnkùn yóò sì máa lépa àwọn ọ̀tá rẹ̀.",
                "poem": 2
              }
            ]
          },
          {
            "type": "line_break"
          },
          {
            "type": "verse",
            "number": 9,
            "content": [
              {
                "text": "Kí ni ẹ̀yìn ń gbìmọ̀ lòdì sí Olúwa?",
                "poem": 1
              },
              {
                "text": "Òun yóò fi òpin sí i,",
                "poem": 2
              },
              {
                "lineBreak": true
              },
              {
                "text": "ìpọ́njú kì yóò wáyé ní ìgbà kejì.",
                "poem": 2
              }
            ]
          },
          {
            "type": "verse",
            "number": 10,
            "content": [
              {
                "text": "Wọn yóò sì lọ́lù papọ̀ bí ẹ̀gún òṣùṣú",
                "poem": 1
              },
              {
                "text": "wọn yóò sì mu àmupara nínú ọtí wáìnì wọn",
                "poem": 2
              },
              {
                "lineBreak": true
              },
              {
                "text": "a ó sì run wọn gẹ́gẹ́ bi àgékù koríko gbígbẹ.",
                "poem": 2
              }
            ]
          },
          {
            "type": "verse",
            "number": 11,
            "content": [
              {
                "text": "Láti ọ̀dọ̀ rẹ, ìwọ Ninefe, ni ẹnìkan ti jáde wá",
                "poem": 1
              },
              {
                "text": "tí ó ń gbèrò ibi sí Olúwa",
                "poem": 2
              },
              {
                "lineBreak": true
              },
              {
                "text": "ti ó sì ń gbìmọ̀ búburú.",
                "poem": 2
              }
            ]
          },
          {
            "type": "verse",
            "number": 12,
            "content": [
              "Báyìí ni Olúwa wí:",
              {
                "text": "“Bí wọ́n tilẹ̀ ni ìfọwọ́sowọ́pọ̀, tí wọ́n sì pọ̀ níye,",
                "poem": 1
              },
              {
                "text": "ṣùgbọ́n, báyìí ní a ó ké wọn lulẹ̀,",
                "poem": 2
              },
              {
                "text": "nígbà tí òun ó bá kọjá.",
                "poem": 1
              },
              {
                "text": "Bí mo tilẹ̀ ti pọ́n ọ lójú ìwọ Juda, èmi kì yóò pọ́n ọ lójúmọ́.",
                "poem": 2
              }
            ]
          },
          {
            "type": "verse",
            "number": 13,
            "content": [
              {
                "text": "Nísinsin yìí ni èmi yóò já àjàgà wọn kúrò ní ọrùn rẹ",
                "poem": 1
              },
              {
                "text": "èmi yóò já ṣẹ́kẹ́ṣẹkẹ̀ rẹ dànù.”",
                "poem": 2
              }
            ]
          },
          {
            "type": "line_break"
          },
          {
            "type": "verse",
            "number": 14,
            "content": [
              {
                "text": "Olúwa ti fi àṣẹ kan lélẹ̀ nítorí tìrẹ Ninefe:",
                "poem": 1
              },
              {
                "text": "“Ìwọ kì yóò ni irú-ọmọ láti máa jẹ́ orúkọ rẹ mọ́,",
                "poem": 2
              },
              {
                "text": "Èmi yóò pa ère fínfín àti ère dídà run",
                "poem": 1
              },
              {
                "text": "tí ó wà nínú tẹmpili àwọn ọlọ́run rẹ.",
                "poem": 2
              },
              {
                "text": "Èmi yóò wa ibojì rẹ,",
                "poem": 1
              },
              {
                "text": "nítorí ẹ̀gbin ni ìwọ.”",
                "poem": 2
              }
            ]
          },
          {
            "type": "line_break"
          },
          {
            "type": "verse",
            "number": 15,
            "content": [
              {
                "text": "Wò ó, lórí àwọn òkè,",
                "poem": 1
              },
              {
                "text": "àwọn ẹsẹ̀ ẹni tí ó mú ìròyìn ayọ̀ wá,",
                "poem": 2
              },
              {
                "lineBreak": true
              },
              {
                "text": "ẹni tí ó ń kéde àlàáfíà.",
                "poem": 2
              },
              {
                "text": "Ìwọ Juda, pa àṣẹ rẹ tí ó ní ìrònú mọ́,",
                "poem": 1
              },
              {
                "text": "kí ó sì san àwọn ẹ̀jẹ́ rẹ.",
                "poem": 2
              },
              {
                "text": "Àwọn ènìyàn búburú kì yóò sì gbóguntì ọ́ mọ́;",
                "poem": 1
              },
              {
                "text": "wọn yóò sì parun pátápátá.",
                "poem": 2
              }
            ]
          }
        ],
        "footnotes": []
      },
