      "book": {
        "id": "ZEP",
        "translationId": "yor_bib",
        "name": "Sefaniah",
        "commonName": "Sefaniah",
        "title": "Ìwé Wòlíì Sefaniah",
        "order": 36,
        "numberOfChapters": 3,
        "sha256": "730d24374c270a24109e9745c5821714353613dc84d7c672317af6bd74d1fe60",
        "firstChapterNumber": 1,
        "firstChapterApiLink": "/api/yor_bib/ZEP/1.json",
        "lastChapterNumber": 3,
        "lastChapterApiLink": "/api/yor_bib/ZEP/3.json",
        "totalNumberOfVerses": 53
      },
      "chapter": {
        "number": 3,
        "content": [
          {
            "type": "heading",
            "content": [
              "Ọjọ́ iwájú Jerusalẹmu"
            ]
          },
          {
            "type": "verse",
            "number": 1,
            "content": [
              {
                "text": "Ègbé ni fún ìlú aninilára,",
                "poem": 1
              },
              {
                "text": "ọlọ̀tẹ̀ àti aláìmọ́.",
                "poem": 2
              }
            ]
          },
          {
            "type": "verse",
            "number": 2,
            "content": [
              {
                "text": "Òun kò gbọ́rọ̀ sí ẹnikẹ́ni,",
                "poem": 1
              },
              {
                "text": "òun kò gba ìtọ́ni,",
                "poem": 2
              },
              {
                "text": "òun kò gbẹ́kẹ̀lé Olúwa,",
                "poem": 1
              },
              {
                "text": "bẹ́ẹ̀ ni òun kò súnmọ́ ọ̀dọ̀ Ọlọ́run rẹ̀.",
                "poem": 2
              }
            ]
          },
          {
            "type": "verse",
            "number": 3,
            "content": [
              {
                "text": "Àwọn olórí rẹ̀ jẹ́ kìnnìún tí ń ké ramúramù,",
                "poem": 1
              },
              {
                "text": "àwọn onídàájọ́ rẹ̀, ìkookò àṣálẹ́ ni wọn,",
                "poem": 2
              },
              {
                "lineBreak": true
              },
              {
                "text": "wọn kò sì fi nǹkan kan kalẹ̀ fún òwúrọ̀.",
                "poem": 2
              }
            ]
          },
          {
            "type": "verse",
            "number": 4,
            "content": [
              {
                "text": "Àwọn wòlíì rẹ̀ gbéraga,",
                "poem": 1
              },
              {
                "text": "wọ́n sì jẹ́ alárékérekè ènìyàn.",
                "poem": 2
              },
              {
                "text": "Àwọn àlùfáà rẹ̀ ti ba ibi mímọ́ jẹ́,",
                "poem": 1
              },
              {
                "text": "wọ́n sì rú òfin.",
                "poem": 2
              }
            ]
          },
          {
            "type": "verse",
            "number": 5,
            "content": [
              {
                "text": "Olúwa ni àárín rẹ̀ jẹ́ olódodo;",
                "poem": 1
              },
              {
                "text": "kì yóò ṣe ohun tí kò tọ̀nà.",
                "poem": 2
              },
              {
                "text": "Àràárọ̀ ni ó máa ń mú ìdájọ́ rẹ̀ wá sí ìmọ́lẹ̀,",
                "poem": 1
              },
              {
                "text": "kì í sì kùnà ní gbogbo ọjọ́ tuntun,",
                "poem": 2
              },
              {
                "lineBreak": true
              },
              {
                "text": "síbẹ̀ àwọn aláìṣòótọ́ kò mọ ìtìjú.",
                "poem": 2
              }
            ]
          },
          {
            "type": "verse",
            "number": 6,
            "content": [
              {
                "text": "“Èmi ti ké àwọn orílẹ̀-èdè kúrò,",
                "poem": 1
              },
              {
                "text": "ilé gíga wọn sì ti bàjẹ́.",
                "poem": 2
              },
              {
                "text": "Mo ti fi ìgboro wọn sílẹ̀ ní òfo",
                "poem": 1
              },
              {
                "text": "tó bẹ́ẹ̀ tí ẹnìkankan kò kọjá níbẹ̀.",
                "poem": 2
              },
              {
                "text": "Ìlú wọn parun tó bẹ́ẹ̀ tí kò sí",
                "poem": 1
              },
              {
                "text": "ẹnìkan tí yóò ṣẹ́kù,",
                "poem": 2
              },
              {
                "lineBreak": true
              },
              {
                "text": "kò sì ní sí ẹnìkan rárá.",
                "poem": 2
              }
            ]
          },
          {
            "type": "verse",
            "number": 7,
            "content": [
              {
                "text": "Èmi wí fún ìlú náà wí pé,",
                "poem": 1
              },
              {
                "text": "‘Nítòótọ́, ìwọ yóò bẹ̀rù mi,",
                "poem": 2
              },
              {
                "lineBreak": true
              },
              {
                "text": "ìwọ yóò sì gba ìtọ́ni!’",
                "poem": 2
              },
              {
                "text": "Bẹ́ẹ̀ ni, a kì yóò ké ibùgbé rẹ̀ kúrò",
                "poem": 1
              },
              {
                "text": "bí ó ti wù kí ń jẹ wọ́n ní yà tó.",
                "poem": 2
              },
              {
                "text": "Ṣùgbọ́n síbẹ̀ wọ́n sì tún ní ìtara",
                "poem": 1
              },
              {
                "text": "láti ṣe ìbàjẹ́.",
                "poem": 2
              }
            ]
          },
          {
            "type": "verse",
            "number": 8,
            "content": [
              {
                "text": "Nítorí náà ẹ dúró dè mí,” ni Olúwa wí,",
                "poem": 1
              },
              {
                "text": "“títí di ọjọ́ náà tí èmi yóò fi jẹ́rìí sí yin.",
                "poem": 2
              },
              {
                "text": "Nítorí ìpinnu mi ni láti kó orílẹ̀-èdè jọ",
                "poem": 1
              },
              {
                "text": "kí èmi kí ó lè kó ilẹ̀ ọba jọ",
                "poem": 2
              },
              {
                "text": "àti láti da ìbínú mi jáde sórí wọn,",
                "poem": 1
              },
              {
                "text": "àní gbogbo ìbínú gbígbóná mi.",
                "poem": 2
              },
              {
                "text": "Nítorí gbogbo ayé",
                "poem": 1
              },
              {
                "text": "ni a ó fi iná owú mi jẹ run.",
                "poem": 2
              }
            ]
          },
          {
            "type": "heading",
            "content": [
              "Ìràpadà àwọn ènìyàn tókù"
            ]
          },
          {
            "type": "verse",
            "number": 9,
            "content": [
              {
                "text": "“Nígbà náà ni èmi yóò yí èdè àwọn ènìyàn padà sí èdè mímọ́,",
                "poem": 1
              },
              {
                "text": "nítorí kí gbogbo wọn bá a lè máa pe orúkọ Olúwa,",
                "poem": 2
              },
              {
                "lineBreak": true
              },
              {
                "text": "láti fi ọkàn kan sìn ín.",
                "poem": 2
              }
            ]
          },
          {
            "type": "verse",
            "number": 10,
            "content": [
              {
                "text": "Láti òkè odò Etiopia,",
                "poem": 1
              },
              {
                "text": "àwọn olùjọsìn mi, àwọn ènìyàn mi tí ó ti fọ́nká,",
                "poem": 2
              },
              {
                "lineBreak": true
              },
              {
                "text": "yóò mú ọrẹ wá fún mi.",
                "poem": 2
              }
            ]
          },
          {
            "type": "verse",
            "number": 11,
            "content": [
              {
                "text": "Ní ọjọ́ náà ni a kì yóò sì dójútì",
                "poem": 1
              },
              {
                "text": "nítorí gbogbo iṣẹ́ ibi ni tí ó ti ṣẹ̀ sí mi,",
                "poem": 2
              },
              {
                "text": "nígbà náà ni èmi yóò mu",
                "poem": 1
              },
              {
                "text": "kúrò nínú ìlú yìí, àwọn tí ń yọ̀ nínú ìgbéraga wọn.",
                "poem": 2
              },
              {
                "text": "Ìwọ kì yóò sì gbéraga mọ́",
                "poem": 1
              },
              {
                "text": "ní òkè mímọ́ mi.",
                "poem": 2
              }
            ]
          },
          {
            "type": "verse",
            "number": 12,
            "content": [
              {
                "text": "Ṣùgbọ́n Èmi yóò fi àwọn ọlọ́kàn tútù",
                "poem": 1
              },
              {
                "text": "àti onírẹ̀lẹ̀ sílẹ̀ pẹ̀lú ni àárín rẹ̀,",
                "poem": 2
              },
              {
                "lineBreak": true
              },
              {
                "text": "wọn yóò sì gbẹ́kẹ̀lé orúkọ Olúwa.",
                "poem": 2
              }
            ]
          },
          {
            "type": "verse",
            "number": 13,
            "content": [
              {
                "text": "Àwọn ìyókù Israẹli kì yóò hùwà ibi,",
                "poem": 1
              },
              {
                "text": "wọn kì yóò sọ̀rọ̀ èké.",
                "poem": 2
              },
              {
                "text": "Bẹ́ẹ̀ ni a kì yóò rí",
                "poem": 1
              },
              {
                "text": "ahọ́n àrékérekè ní ẹnu wọn.",
                "poem": 2
              },
              {
                "text": "Àwọn yóò jẹun, wọn yóò sì dùbúlẹ̀,",
                "poem": 1
              },
              {
                "text": "bẹ́ẹ̀ ni ẹnikẹ́ni kì yóò dẹ́rùbà wọ́n.”",
                "poem": 2
              }
            ]
          },
          {
            "type": "line_break"
          },
          {
            "type": "verse",
            "number": 14,
            "content": [
              {
                "text": "Kọrin, ìwọ ọmọbìnrin Sioni,",
                "poem": 1
              },
              {
                "text": "kígbe sókè, ìwọ Israẹli!",
                "poem": 2
              },
              {
                "text": "Fi gbogbo ọkàn yọ̀, kí inú rẹ kí ó sì dùn,",
                "poem": 1
              },
              {
                "text": "ìwọ ọmọbìnrin Jerusalẹmu.",
                "poem": 2
              }
            ]
          },
          {
            "type": "verse",
            "number": 15,
            "content": [
              {
                "text": "Olúwa ti mú ìdájọ́ rẹ wọ̀n-ọn-nì kúrò,",
                "poem": 1
              },
              {
                "text": "ó sì ti ti àwọn ọ̀tá rẹ padà sẹ́yìn.",
                "poem": 2
              },
              {
                "text": "Olúwa, ọba Israẹli wà pẹ̀lú rẹ;",
                "poem": 1
              },
              {
                "text": "ìwọ kì yóò sì bẹ̀rù ibi kan mọ́.",
                "poem": 2
              }
            ]
          },
          {
            "type": "verse",
            "number": 16,
            "content": [
              {
                "text": "Ní ọjọ́ náà, wọn yóò sọ fún Jerusalẹmu pé,",
                "poem": 1
              },
              {
                "text": "“Má ṣe bẹ̀rù Sioni;",
                "poem": 2
              },
              {
                "lineBreak": true
              },
              {
                "text": "má sì ṣe jẹ́ kí ọwọ́ rẹ kí ó dẹ̀.",
                "poem": 2
              }
            ]
          },
          {
            "type": "verse",
            "number": 17,
            "content": [
              {
                "text": "Olúwa Ọlọ́run rẹ wà pẹ̀lú rẹ,",
                "poem": 1
              },
              {
                "text": "Ó ní agbára láti gbà ọ là.",
                "poem": 2
              },
              {
                "text": "Yóò yọ̀ ni orí rẹ fún ayọ̀;",
                "poem": 1
              },
              {
                "text": "Yóò tún ọ ṣe nínú ìfẹ́ rẹ̀,",
                "poem": 2
              },
              {
                "lineBreak": true
              },
              {
                "text": "Yóò sì fi orin yọ̀ ní orí rẹ.”",
                "poem": 2
              }
            ]
          },
          {
            "type": "line_break"
          },
          {
            "type": "verse",
            "number": 18,
            "content": [
              {
                "text": "“Èmi ó kó àwọn tí ó ń banújẹ́ fún àjọ̀dún tí a yàn jọ,",
                "poem": 1
              },
              {
                "text": "àwọn tí ó jẹ́ tirẹ̀;",
                "poem": 2
              },
              {
                "lineBreak": true
              },
              {
                "text": "àwọn tí ẹ̀gàn rẹ̀ jásí ẹ̀rù.",
                "poem": 2
              }
            ]
          },
          {
            "type": "verse",
            "number": 19,
            "content": [
              {
                "text": "Ní àkókò náà",
                "poem": 1
              },
              {
                "text": "ni èmi yóò dojúkọ àwọn",
                "poem": 2
              },
              {
                "text": "tí ń ni yín lára,",
                "poem": 1
              },
              {
                "text": "èmi yóò gba àtiro là,",
                "poem": 2
              },
              {
                "text": "èmi yóò sì ṣa àwọn tí ó ti fọ́nká jọ,",
                "poem": 1
              },
              {
                "text": "èmi yóò fi ìyìn àti ọlá fún wọn ní",
                "poem": 2
              },
              {
                "lineBreak": true
              },
              {
                "text": "gbogbo ilẹ̀ tí a bá ti dójútì wọ́n.",
                "poem": 2
              }
            ]
          },
          {
            "type": "verse",
            "number": 20,
            "content": [
              {
                "text": "Ní àkókò náà ni èmi yóò ṣà yín jọ;",
                "poem": 1
              },
              {
                "text": "nígbà náà ni èmi yóò mú un yín padà wá sílé.",
                "poem": 2
              },
              {
                "text": "Èmi yóò fi ọlá àti ìyìn fún un yín",
                "poem": 1
              },
              {
                "text": "láàrín gbogbo ènìyàn àgbáyé,",
                "poem": 2
              },
              {
                "text": "nígbà tí èmi yóò yí ìgbèkùn yín",
                "poem": 1
              },
              {
                "text": "padà bọ sípò ní ojú ara yín,”",
                "poem": 2
              },
              {
                "lineBreak": true
              },
              {
                "text": "ni Olúwa wí.",
                "poem": 2
              }
            ]
          }
