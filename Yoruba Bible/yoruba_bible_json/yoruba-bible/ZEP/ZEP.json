      "chapter": {
        "number": 2,
        "content": [
          {
            "type": "heading",
            "content": [
              "Ìpè si Ìrònúpìwàdà"
            ]
          },
          {
            "type": "verse",
            "number": 1,
            "content": [
              {
                "text": "Ẹ kó ara yín jọ pọ̀, àní ẹ kó ra yín jọ pọ̀",
                "poem": 1
              },
              {
                "text": "orílẹ̀-èdè tí kò ní ìtìjú,",
                "poem": 2
              }
            ]
          },
          {
            "type": "verse",
            "number": 2,
            "content": [
              {
                "text": "kí a tó pa àṣẹ náà, kí ọjọ́ náà tó kọjá bí ìyàngbò ọkà,",
                "poem": 1
              },
              {
                "text": "kí gbígbóná ìbínú Olúwa tó dé bá a yín,",
                "poem": 2
              },
              {
                "text": "kí ọjọ́ ìbínú Olúwa kí ó tó dé bá a yín.",
                "poem": 1
              }
            ]
          },
          {
            "type": "verse",
            "number": 3,
            "content": [
              {
                "lineBreak": true
              },
              {
                "text": "Ẹ wá Olúwa, gbogbo ẹ̀yin onírẹ̀lẹ̀ ilẹ̀ náà,",
                "poem": 1
              },
              {
                "text": "ẹ̀yin tí ń ṣe ohun tí ó bá pàṣẹ.",
                "poem": 2
              },
              {
                "text": "Ẹ wá òdodo, ẹ wá ìrẹ̀lẹ̀ pẹ̀lú,",
                "poem": 1
              },
              {
                "text": "bóyá á ó pa yín mọ́ ní ọjọ́ ìbínú Olúwa.",
                "poem": 2
              }
            ]
          },
          {
            "type": "heading",
            "content": [
              "Ìlòdì sí Filistia"
            ]
          },
          {
            "type": "verse",
            "number": 4,
            "content": [
              {
                "text": "Nítorí pé, a ó kọ Gasa sílẹ̀,",
                "poem": 1
              },
              {
                "text": "Aṣkeloni yóò sì dahoro.",
                "poem": 2
              },
              {
                "text": "Ní ọ̀sán gangan ni a ó lé Aṣdodu jáde,",
                "poem": 1
              },
              {
                "text": "a ó sì fa Ekroni tu kúrò.",
                "poem": 2
              }
            ]
          },
          {
            "type": "verse",
            "number": 5,
            "content": [
              {
                "text": "Ègbé ni fún ẹ̀yin tí ń gbé etí Òkun,",
                "poem": 1
              },
              {
                "text": "ẹ̀yin ènìyàn ara Kereti;",
                "poem": 2
              },
              {
                "text": "ọ̀rọ̀ Olúwa dojúkọ ọ́, ìwọ Kenaani,",
                "poem": 1
              },
              {
                "text": "ilẹ̀ àwọn ara Filistini.",
                "poem": 2
              },
              {
                "text": "“Èmi yóò pa yín run,",
                "poem": 1
              },
              {
                "text": "ẹnìkan kò sì ní ṣẹ́kù nínú yín.”",
                "poem": 2
              }
            ]
          },
          {
            "type": "verse",
            "number": 6,
            "content": [
              {
                "text": "Ilẹ̀ náà ní etí Òkun, ni ibùgbé àwọn ará Kereti,",
                "poem": 1
              },
              {
                "text": "ni yóò jẹ́ ibùjókòó fún àwọn olùṣọ́-àgùntàn àti agbo àgùntàn.",
                "poem": 2
              }
            ]
          },
          {
            "type": "verse",
            "number": 7,
            "content": [
              {
                "text": "Agbègbè náà yóò sì jẹ́ ti ìyókù àwọn ilé Juda,",
                "poem": 1
              },
              {
                "text": "níbẹ̀ ni wọn yóò sì ti rí koríko fún ẹran.",
                "poem": 2
              },
              {
                "text": "Ní ilé Aṣkeloni ni wọn yóò",
                "poem": 1
              },
              {
                "text": "dùbúlẹ̀ ni àṣálẹ́.",
                "poem": 2
              },
              {
                "text": "Olúwa Ọlọ́run wọn yóò bẹ̀ wọn wò,",
                "poem": 1
              },
              {
                "text": "yóò sì yí ìgbèkùn wọn padà.",
                "poem": 2
              }
            ]
          },
          {
            "type": "heading",
            "content": [
              "Ìlòdì sí Moabu àti Ammoni"
            ]
          },
          {
            "type": "verse",
            "number": 8,
            "content": [
              {
                "text": "“Èmi ti gbọ́ ẹ̀gàn Moabu,",
                "poem": 1
              },
              {
                "text": "àti ẹlẹ́yà àwọn Ammoni,",
                "poem": 2
              },
              {
                "text": "àwọn tó kẹ́gàn àwọn ènìyàn mi,",
                "poem": 1
              },
              {
                "text": "tí wọ́n sì ti gbé ara wọn ga sí agbègbè wọn.",
                "poem": 2
              }
            ]
          },
          {
            "type": "verse",
            "number": 9,
            "content": [
              {
                "text": "Nítorí náà, bí Èmi tí wà,”",
                "poem": 1
              },
              {
                "text": "ni Olúwa àwọn ọmọ-ogun,",
                "poem": 2
              },
              {
                "lineBreak": true
              },
              {
                "text": "Ọlọ́run àwọn Israẹli wí,",
                "poem": 2
              },
              {
                "text": "“nítòótọ́ Moabu yóò dàbí Sodomu,",
                "poem": 1
              },
              {
                "text": "àti Ammoni yóò sì dàbí Gomorra,",
                "poem": 2
              },
              {
                "text": "ibi tí ó kún fún yèrèpè,",
                "poem": 1
              },
              {
                "text": "àti ìhó iyọ̀ àti ìdahoro títí láéláé.",
                "poem": 2
              },
              {
                "text": "Ìyókù àwọn ènìyàn mi yóò kó wọn;",
                "poem": 1
              },
              {
                "text": "àwọn tí ó sì yọ nínú ewu ní orílẹ̀-èdè mi ni yóò jogún ilẹ̀ wọn.”",
                "poem": 2
              }
            ]
          },
          {
            "type": "line_break"
          },
          {
            "type": "verse",
            "number": 10,
            "content": [
              {
                "text": "Èyí ni ohun tí wọn yóò gbà padà nítorí ìgbéraga wọn,",
                "poem": 1
              },
              {
                "text": "nítorí wọ́n kẹ́gàn, wọn sì ti fi àwọn ènìyàn Olúwa àwọn ọmọ-ogun ṣe ẹlẹ́yà.",
                "poem": 2
              }
            ]
          },
          {
            "type": "verse",
            "number": 11,
            "content": [
              {
                "text": "Olúwa yóò jẹ́ ìbẹ̀rù fún wọn;",
                "poem": 1
              },
              {
                "text": "nígbà tí Òun bá pa gbogbo òrìṣà ilẹ̀ náà run.",
                "poem": 2
              },
              {
                "text": "Orílẹ̀-èdè láti etí odò yóò máa sìn,",
                "poem": 1
              },
              {
                "text": "olúkúlùkù láti ilẹ̀ rẹ̀ wá.",
                "poem": 2
              }
            ]
          },
          {
            "type": "verse",
            "number": 12,
            "content": [
              {
                "text": "“Ẹ̀yin Etiopia pẹ̀lú,",
                "poem": 1
              },
              {
                "text": "a ó fi idà mi pa yín.”",
                "poem": 2
              }
            ]
          },
          {
            "type": "heading",
            "content": [
              "Asiria"
            ]
          },
          {
            "type": "verse",
            "number": 13,
            "content": [
              {
                "text": "Òun yóò sì na ọwọ́ rẹ̀ sí apá àríwá,",
                "poem": 1
              },
              {
                "text": "yóò sì pa Asiria run,",
                "poem": 2
              },
              {
                "text": "yóò sì sọ Ninefe di ahoro,",
                "poem": 1
              },
              {
                "text": "àti di gbígbẹ bí aginjù.",
                "poem": 2
              }
            ]
          },
          {
            "type": "verse",
            "number": 14,
            "content": [
              {
                "text": "Agbo ẹran yóò sì dùbúlẹ̀ ni àárín rẹ̀,",
                "poem": 1
              },
              {
                "text": "àti gbogbo ẹranko àwọn orílẹ̀-èdè.",
                "poem": 2
              },
              {
                "text": "Òwìwí aginjù àti ti n kígbe ẹyẹ òwìwí",
                "poem": 1
              },
              {
                "text": "yóò wọ bí ẹyẹ ni ọwọ̀n rẹ̀.",
                "poem": 2
              },
              {
                "text": "Ohùn wọn yóò kọrin ni ojú fèrèsé,",
                "poem": 1
              },
              {
                "text": "ìdahoro yóò wà nínú ìloro ẹnu-ọ̀nà,",
                "poem": 2
              },
              {
                "lineBreak": true
              },
              {
                "text": "òun yóò sì ṣẹ́ ọ̀pá kedari sílẹ̀.",
                "poem": 2
              }
            ]
          },
          {
            "type": "verse",
            "number": 15,
            "content": [
              {
                "text": "Èyí ni ìlú aláyọ̀ tí ó ń gbé láìléwu.",
                "poem": 1
              },
              {
                "text": "Ó sì sọ fun ara rẹ̀ pé,",
                "poem": 2
              },
              {
                "text": "“Èmi ni, kò sì sí ẹnìkan tí ó ń bẹ lẹ́yìn mi.”",
                "poem": 1
              },
              {
                "text": "Irú ahoro wo ni òun ha ti jẹ́,",
                "poem": 2
              },
              {
                "text": "ibùgbé fún àwọn ẹranko igbó!",
                "poem": 1
              },
              {
                "text": "Gbogbo ẹni tí ó bá kọjá ọ̀dọ̀ rẹ̀",
                "poem": 2
              },
              {
                "text": "yóò fi rẹ́rìn-ín ẹlẹ́yà,",
                "poem": 1
              },
              {
                "text": "wọ́n yóò sì gbọn ẹsẹ̀ wọn.",
                "poem": 2
              }
            ]
          }
        ],
        "footnotes": []
      },
