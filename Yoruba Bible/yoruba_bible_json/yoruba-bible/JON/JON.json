      "chapter": {
        "number": 2,
        "content": [
          {
            "type": "heading",
            "content": [
              "Àdúrà Jona"
            ]
          },
          {
            "type": "verse",
            "number": 1,
            "content": [
              "Nígbà náà ni Jona gbàdúrà sí Olúwa Ọlọ́run rẹ̀ láti inú ẹja náà wá,"
            ]
          },
          {
            "type": "verse",
            "number": 2,
            "content": [
              "Ó sì wí pé:",
              {
                "text": "“Nínú ìpọ́njú mi ni mo kígbe sí Olúwa,",
                "poem": 1
              },
              {
                "text": "òun sì gbọ́ ohùn mi.",
                "poem": 2
              },
              {
                "text": "Mo kígbe láti inú ipò òkú, mo pè fún ìrànwọ́,",
                "poem": 1
              },
              {
                "text": "ìwọ sì gbọ́ ohùn mi.",
                "poem": 2
              }
            ]
          },
          {
            "type": "verse",
            "number": 3,
            "content": [
              {
                "text": "Nítorí tí ìwọ ti sọ mí sínú ibú,",
                "poem": 1
              },
              {
                "text": "ní àárín Òkun,",
                "poem": 2
              },
              {
                "lineBreak": true
              },
              {
                "text": "ìṣàn omi sì yí mi káàkiri;",
                "poem": 2
              },
              {
                "text": "gbogbo bíbì omi àti rírú omi",
                "poem": 1
              },
              {
                "text": "rékọjá lórí mi.",
                "poem": 2
              }
            ]
          },
          {
            "type": "verse",
            "number": 4,
            "content": [
              {
                "text": "Nígbà náà ni mo wí pé,",
                "poem": 1
              },
              {
                "text": "‘A ta mí nù kúrò níwájú rẹ;",
                "poem": 2
              },
              {
                "text": "ṣùgbọ́n síbẹ̀ èmi yóò tún",
                "poem": 1
              },
              {
                "text": "máa wo ìhà tẹmpili mímọ́ rẹ.’",
                "poem": 2
              }
            ]
          },
          {
            "type": "verse",
            "number": 5,
            "content": [
              {
                "text": "Omi yí mi káàkiri, àní títí dé ọkàn;",
                "poem": 1
              },
              {
                "text": "ibú yí mi káàkiri,",
                "poem": 2
              },
              {
                "lineBreak": true
              },
              {
                "text": "a fi koríko odò wé mi lórí.",
                "poem": 2
              }
            ]
          },
          {
            "type": "verse",
            "number": 6,
            "content": [
              {
                "text": "Èmi sọ̀kalẹ̀ lọ sí ìsàlẹ̀ àwọn òkè ńlá;",
                "poem": 1
              },
              {
                "text": "ilẹ̀ ayé pẹ̀lú ìdènà rẹ̀ yí mi ká títí:",
                "poem": 2
              },
              {
                "text": "ṣùgbọ́n ìwọ ti mú ẹ̀mí mi wá sókè láti inú ibú wá,",
                "poem": 1
              },
              {
                "text": "Olúwa Ọlọ́run mi.",
                "poem": 2
              }
            ]
          },
          {
            "type": "line_break"
          },
          {
            "type": "verse",
            "number": 7,
            "content": [
              {
                "text": "“Nígbà tí ó rẹ ọkàn mi nínú mi,",
                "poem": 1
              },
              {
                "text": "èmi rántí rẹ, Olúwa,",
                "poem": 2
              },
              {
                "text": "àdúrà mi sì wá sí ọ̀dọ̀ rẹ,",
                "poem": 1
              },
              {
                "text": "nínú tẹmpili mímọ́ rẹ.",
                "poem": 2
              }
            ]
          },
          {
            "type": "line_break"
          },
          {
            "type": "verse",
            "number": 8,
            "content": [
              {
                "text": "“Àwọn tí ń fàmọ́ òrìṣà èké",
                "poem": 1
              },
              {
                "text": "kọ àánú ara wọn sílẹ̀.",
                "poem": 2
              }
            ]
          },
          {
            "type": "verse",
            "number": 9,
            "content": [
              {
                "text": "Ṣùgbọ́n èmi yóò fi orin ọpẹ́, rú ẹbọ sí ọ.",
                "poem": 1
              },
              {
                "text": "Èmi yóò san ẹ̀jẹ́ tí mo ti jẹ́.",
                "poem": 2
              },
              {
                "lineBreak": true
              },
              {
                "text": "‘Ìgbàlà wá láti ọ̀dọ̀ Olúwa.’ ”",
                "poem": 2
              }
            ]
          },
          {
            "type": "verse",
            "number": 10,
            "content": [
              "Olúwa sì pàṣẹ fún ẹja náà, ó sì pọ Jona sí orí ilẹ̀ gbígbẹ."
            ]
          }
        ],
        "footnotes": []
      },
