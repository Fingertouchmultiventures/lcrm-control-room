    "3": {
      "translation": {
        "id": "yor_bib",
        "name": "Biblica® ní oore ọ̀fẹ́ láti lo Bíbélì Mímọ́ ní Èdè Yorùbá Òde-Òní",
        "website": "https://ebible.org/Scriptures/details.php?id=yor",
        "licenseUrl": "https://ebible.org/Scriptures/details.php?id=yor",
        "licenseNotes": null,
        "shortName": "BIB",
        "englishName": "Yoruba Bible",
        "language": "yor",
        "textDirection": "ltr",
        "sha256": "7761f8c9559b01566ca9490fb77c26b38960fb922d29a9e48641b9ea5af56ed6",
        "availableFormats": [
          "json"
        ],
        "listOfBooksApiLink": "/api/yor_bib/books.json",
        "numberOfBooks": 66,
