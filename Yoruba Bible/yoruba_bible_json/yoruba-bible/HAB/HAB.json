      },
      "book": {
        "id": "HAB",
        "translationId": "yor_bib",
        "name": "Habakuku",
        "commonName": "Habakuku",
        "title": "Ìwé Wòlíì Habakuku",
        "order": 35,
        "numberOfChapters": 3,
        "sha256": "169e679ac4840cf44f6e508e7cde621809e8da218857c7ad7c4da760fe5b0e86",
        "firstChapterNumber": 1,
        "firstChapterApiLink": "/api/yor_bib/HAB/1.json",
        "lastChapterNumber": 3,
        "lastChapterApiLink": "/api/yor_bib/HAB/3.json",
        "totalNumberOfVerses": 56
      },
      "chapter": {
        "number": 3,
        "content": [
          {
            "type": "heading",
            "content": [
              "Àdúrà Habakuku"
            ]
          },
          {
            "type": "verse",
            "number": 1,
            "content": [
              {
                "text": "Àdúrà wòlíì Habakuku gẹ́gẹ́ bí sígónótì. Ohun èlò orin.",
                "descriptive": true
              }
            ]
          },
          {
            "type": "verse",
            "number": 2,
            "content": [
              {
                "text": "Olúwa mo tí gbọ́ ohùn rẹ;",
                "poem": 1
              },
              {
                "text": "ẹ̀rù sì ba mi fún iṣẹ́ rẹ Olúwa",
                "poem": 2
              },
              {
                "text": "sọ wọn di ọ̀tún ní ọjọ́ ti wa,",
                "poem": 1
              },
              {
                "text": "ní àkókò tiwa, jẹ́ kó di mí mọ̀;",
                "poem": 2
              },
              {
                "lineBreak": true
              },
              {
                "text": "ni ìbínú, rántí àánú.",
                "poem": 2
              }
            ]
          },
          {
            "type": "line_break"
          },
          {
            "type": "verse",
            "number": 3,
            "content": [
              {
                "text": "Ọlọ́run yóò wa láti Temani,",
                "poem": 1
              },
              {
                "text": "ibi mímọ́ jùlọ láti òkè Parani",
                "poem": 2
              },
              {
                "text": "ògo rẹ̀ sí bo àwọn ọ̀run,",
                "poem": 1
              },
              {
                "text": "ilé ayé sì kún fún ìyìn rẹ.",
                "poem": 2
              }
            ]
          },
          {
            "type": "verse",
            "number": 4,
            "content": [
              {
                "text": "Dídán rẹ sí dàbí ìmọ́lẹ̀ oòrùn",
                "poem": 1
              },
              {
                "text": "ìtànṣán ìmọ́lẹ̀ jáde wa láti ọwọ́ rẹ,",
                "poem": 2
              },
              {
                "lineBreak": true
              },
              {
                "text": "níbi tí wọn fi agbára rẹ̀ pamọ́ sí.",
                "poem": 2
              }
            ]
          },
          {
            "type": "verse",
            "number": 5,
            "content": [
              {
                "text": "Àjàkálẹ̀-ààrùn ń lọ ni iwájú rẹ;",
                "poem": 1
              },
              {
                "text": "ìyọnu sí ń tọ ẹsẹ̀ rẹ lọ.",
                "poem": 2
              }
            ]
          },
          {
            "type": "verse",
            "number": 6,
            "content": [
              {
                "text": "Ó dúró, ó sì mi ayé;",
                "poem": 1
              },
              {
                "text": "ó wò, ó sì mú àwọn orílẹ̀-èdè wárìrì",
                "poem": 2
              },
              {
                "text": "a sì tú àwọn òkè ńlá ayérayé ká,",
                "poem": 1
              },
              {
                "text": "àwọn òkè kéékèèké ayérayé sì tẹríba:",
                "poem": 2
              },
              {
                "lineBreak": true
              },
              {
                "text": "ọ̀nà rẹ ayérayé ni.",
                "poem": 2
              }
            ]
          },
          {
            "type": "verse",
            "number": 7,
            "content": [
              {
                "text": "Mo rí àgọ́ Kuṣani nínú ìpọ́njú",
                "poem": 1
              },
              {
                "text": "àti àwọn ibùgbé Midiani nínú ìrora.",
                "poem": 2
              }
            ]
          },
          {
            "type": "line_break"
          },
          {
            "type": "verse",
            "number": 8,
            "content": [
              {
                "text": "Ǹjẹ́ ìwọ ha ń bínú sí àwọn odò nì, Olúwa?",
                "poem": 1
              },
              {
                "text": "Ǹjẹ́ ìbínú rẹ wa lórí àwọn odò ṣíṣàn bí?",
                "poem": 2
              },
              {
                "text": "Ìbínú rẹ ha wá sórí Òkun",
                "poem": 1
              },
              {
                "text": "tí ìwọ fi ń gun ẹṣin,",
                "poem": 2
              },
              {
                "lineBreak": true
              },
              {
                "text": "àti kẹ̀kẹ́ ìgbàlà rẹ?",
                "poem": 2
              }
            ]
          },
          {
            "type": "verse",
            "number": 9,
            "content": [
              {
                "text": "A ṣí ọrun rẹ sílẹ̀ pátápátá,",
                "poem": 1
              },
              {
                "text": "gẹ́gẹ́ bí ìbúra àwọn ẹ̀yà, àní ọ̀rọ̀ rẹ,",
                "poem": 2
              },
              {
                "text": "ìwọ sì fi odò pín ilẹ̀ ayé.",
                "poem": 1
              }
            ]
          },
          {
            "type": "verse",
            "number": 10,
            "content": [
              {
                "text": "Àwọn òkè ńlá ri ọ wọn sì wárìrì",
                "poem": 2
              },
              {
                "text": "àgbàrá òjò ń sàn án kọjá lọ;",
                "poem": 1
              },
              {
                "text": "ibú ń ké ramúramù",
                "poem": 2
              },
              {
                "lineBreak": true
              },
              {
                "text": "ó sì gbé irú omi sókè.",
                "poem": 2
              }
            ]
          },
          {
            "type": "line_break"
          },
          {
            "type": "verse",
            "number": 11,
            "content": [
              {
                "text": "Òòrùn àti Òṣùpá dúró jẹ́ẹ́jẹ́ ni ibùgbé wọn,",
                "poem": 1
              },
              {
                "text": "pẹ̀lú ìmọ́lẹ̀ ọfà rẹ ni wọn yára lọ,",
                "poem": 2
              },
              {
                "lineBreak": true
              },
              {
                "text": "àti ni dídán ọ̀kọ̀ rẹ ti ń kọ mànà.",
                "poem": 2
              }
            ]
          },
          {
            "type": "verse",
            "number": 12,
            "content": [
              {
                "text": "Ní ìrunú ni ìwọ rin ilẹ̀ náà já,",
                "poem": 1
              },
              {
                "text": "ní ìbínú ni ìwọ tí tẹ́ àwọn orílẹ̀-èdè rẹ.",
                "poem": 2
              }
            ]
          },
          {
            "type": "verse",
            "number": 13,
            "content": [
              {
                "text": "Ìwọ jáde lọ láti tú àwọn ènìyàn rẹ sílẹ̀,",
                "poem": 1
              },
              {
                "text": "àti láti gba ẹni àmì òróró rẹ là,",
                "poem": 2
              },
              {
                "text": "Ìwọ ti run àwọn olórí kúrò nínú ilẹ̀ àwọn ènìyàn búburú,",
                "poem": 1
              },
              {
                "text": "ó sì bọ ìhámọ́ra rẹ láti orí de ẹsẹ̀.",
                "poem": 2
              }
            ]
          },
          {
            "type": "verse",
            "number": 14,
            "content": [
              {
                "text": "Pẹ̀lú ọ̀kọ̀ rẹ̀ kí ó fi gún orí rẹ",
                "poem": 1
              },
              {
                "text": "nígbà tí àwọn jagunjagun rẹ̀",
                "poem": 2
              },
              {
                "text": "jáde láti tú wá ká,",
                "poem": 1
              },
              {
                "text": "ayọ̀ wọn sì ni láti jẹ tálákà run ní ìkọ̀kọ̀.",
                "poem": 2
              }
            ]
          },
          {
            "type": "verse",
            "number": 15,
            "content": [
              {
                "text": "Ìwọ fi ẹṣin rẹ rìn Òkun já,",
                "poem": 1
              },
              {
                "text": "ó sì da àwọn omi ńlá ru.",
                "poem": 2
              }
            ]
          },
          {
            "type": "line_break"
          },
          {
            "type": "verse",
            "number": 16,
            "content": [
              {
                "text": "Mo gbọ́, ọkàn mi sì wárìrì,",
                "poem": 1
              },
              {
                "text": "ètè mi sì gbọ̀n sí ìró náà;",
                "poem": 2
              },
              {
                "text": "ìbàjẹ́ sì wọ inú egungun mi lọ,",
                "poem": 1
              },
              {
                "text": "ẹsẹ̀ mi sì wárìrì,",
                "poem": 2
              },
              {
                "text": "mo dúró ni ìdákẹ́ jẹ́ẹ́ fún ọjọ́ ìdààmú",
                "poem": 1
              },
              {
                "text": "láti de sórí àwọn ènìyàn tó ń dojúkọ wá.",
                "poem": 2
              }
            ]
          },
          {
            "type": "verse",
            "number": 17,
            "content": [
              {
                "text": "Bí igi ọ̀pọ̀tọ́ ko tilẹ̀ tanná,",
                "poem": 1
              },
              {
                "text": "tí èso kò sí nínú àjàrà;",
                "poem": 2
              },
              {
                "text": "tí igi olifi ko le so,",
                "poem": 1
              },
              {
                "text": "àwọn oko ko sì mú oúnjẹ wá;",
                "poem": 2
              },
              {
                "text": "tí a sì ké agbo ẹran kúrò nínú agbo,",
                "poem": 1
              },
              {
                "text": "tí kò sì sí ọwọ́ ẹran ni ibùso mọ́,",
                "poem": 2
              }
            ]
          },
          {
            "type": "verse",
            "number": 18,
            "content": [
              {
                "text": "síbẹ̀, èmi ó láyọ̀ nínú Olúwa,",
                "poem": 1
              },
              {
                "text": "èmi yóò sí máa yọ nínú Ọlọ́run ìgbàlà mi.",
                "poem": 2
              }
            ]
          },
          {
            "type": "line_break"
          },
          {
            "type": "verse",
            "number": 19,
            "content": [
              {
                "text": "Olúwa Olódùmarè ni agbára mi,",
                "poem": 1
              },
              {
                "text": "òun yóò sí ṣe ẹsẹ̀ mi bí ẹsẹ̀ abo àgbọ̀nrín,",
                "poem": 2
              },
              {
                "lineBreak": true
              },
              {
                "text": "yóò sí mú mi rìn lórí ibi gíga.",
                "poem": 2
              },
              {
                "text": "Sí olórí akọrin lórí ohun èlò orin olókùn mi.",
                "descriptive": true
              }
            ]
          }
        ],
        "footnotes": []
